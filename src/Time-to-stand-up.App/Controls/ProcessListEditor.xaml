<UserControl x:Class="TimeToStandUp.App.ProcessListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="14">
    <!-- 例外程式清單:手動輸入名稱或從執行中的程式挑選。 -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="例外程式" FontSize="18" FontWeight="Medium" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                   Foreground="{DynamicResource Glass.SubTextBrush}"
                   Text="清單中任一程式開著(包含最小化)時暫停計時、不跳出休息;全部關閉後從頭開始計時。請勿加入一直在執行的程式(例如 explorer),否則永遠不會提醒。" />

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Padding="6,4" VerticalContentAlignment="Center"
                     AutomationProperties.Name="要加入的程式名稱,例如 POWERPNT.EXE"
                     ToolTip="程式名稱,例如 POWERPNT.EXE 或 zoom"
                     TextChanged="OnNameChanged" PreviewKeyDown="OnNameKeyDown" />
            <Button x:Name="AddButton" Grid.Column="1" Content="新&#x200A;增" Padding="16,5" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnAddClick" />
        </Grid>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Glass.ErrorBrush}" Visibility="Collapsed" />

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
            <Button x:Name="PickButton" DockPanel.Dock="Left" Content="從執行中的程式挑選…" Padding="14,5"
                    Click="OnPickClick" />
            <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="刪&#x200A;除" Padding="16,5"
                    IsEnabled="False" Click="OnRemoveClick" />
        </DockPanel>

        <Grid Margin="0,10,0,0">
            <ListBox x:Name="EntryList" MinHeight="96"
                     AutomationProperties.Name="例外程式清單"
                     SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" />
            <TextBlock x:Name="EmptyHint" Text="尚未加入任何程式" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Glass.SubTextBrush}" />
        </Grid>
    </DockPanel>
</UserControl>
