<Window x:Class="TimeToStandUp.App.WarningToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time-to-stand-up 提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}">
    <Border Background="#F01B2733"
            BorderBrush="#FF3B5266" BorderThickness="1"
            CornerRadius="10" Padding="20,14"
            Cursor="Hand"
            MouseLeftButtonUp="OnClick">
        <StackPanel>
            <TextBlock x:Name="MessageText" FontSize="16" FontWeight="Medium" Foreground="#FFE8EEF4" />
            <TextBlock Text="點一下可關閉這則提示" Margin="0,4,0,0" FontSize="12" Foreground="#FF9FB3C4" />
        </StackPanel>
    </Border>
</Window>
