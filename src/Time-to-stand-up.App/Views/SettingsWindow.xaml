<Window x:Class="TimeToStandUp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimeToStandUp.App"
        Title="Time-to-stand-up 設定"
        Width="700" Height="700"
        MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource Glass.TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theming/Themes/Glass.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="Tabs" Grid.Row="0" Margin="16,16,16,0">
        <TabItem Header="提&#x200A;醒&#x200A;設&#x200A;定" Padding="14,6">
            <StackPanel Margin="18">
                <TextBlock Text="選擇提醒的節奏" FontSize="18" FontWeight="Medium" Margin="0,0,0,12" />
                <local:PresetPicker x:Name="Picker" />
                <CheckBox x:Name="AutoStartBox" Content="開機時自動啟動" Margin="0,18,0,0" />
                <TextBlock x:Name="ApplyHint" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Glass.SubTextBrush}" />
            </StackPanel>
        </TabItem>

        <TabItem Header="寵&#x200A;物" Padding="14,6">
            <StackPanel Margin="18">
                <TextBlock Text="選擇休息時陪你的寵物" FontSize="18" FontWeight="Medium" Margin="0,0,0,12" />
                <local:PetPicker x:Name="PetPicker" />
            </StackPanel>
        </TabItem>

        <TabItem Header="例&#x200A;外&#x200A;程&#x200A;式" Padding="14,6">
            <local:ProcessListEditor x:Name="ProcessEditor" Margin="18" />
        </TabItem>

        <TabItem Header="研&#x200A;究&#x200A;依&#x200A;據&#x200A;與&#x200A;關&#x200A;於" Padding="14,6">
            <local:ResearchInfoPanel Margin="18" />
        </TabItem>
    </TabControl>

    <DockPanel Grid.Row="1" LastChildFill="False" Margin="32,12,32,16">
        <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="回復預設" Padding="14,5"
                Click="OnResetClick" />
        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="儲&#x200A;存" Padding="22,5" IsDefault="True"
                Click="OnSaveClick" />
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取&#x200A;消" Padding="22,5"
                Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick" />
    </DockPanel>
    <Button x:Name="ThemeButton" Style="{StaticResource Glass.IconButton}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
            AutomationProperties.Name="切換深色與淺色" ToolTip="切換深色 / 淺色"
            Click="OnThemeClick" />
    </Grid>
</Window>
