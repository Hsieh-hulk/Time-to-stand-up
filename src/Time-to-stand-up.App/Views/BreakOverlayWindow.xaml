<Window x:Class="TimeToStandUp.App.BreakOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimeToStandUp.App"
        Title="Time-to-stand-up"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#FF0F1720"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="#FFE8EEF4">
    <Window.Resources>
        <Style x:Key="UnlockButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF1A1205" />
            <Setter Property="Background" Value="#FFE8C068" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="44,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF2D58E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD2A94E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF6B5E3C" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 背景動畫(僅主螢幕,由 BreakAnimations 依設定建立),在內容後方 -->
        <Grid x:Name="AnimationHost" IsHitTestVisible="False" />

        <!-- 內容以 900 DIP 高為基準設計,Loaded / SizeChanged 時用 LayoutTransform 隨螢幕縮放 -->
        <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontSize="44" FontWeight="Medium"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="HintText"
                       Margin="0,10,0,0" FontSize="20" Foreground="#FF9FB3C4"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720"
                       HorizontalAlignment="Center" />
            <local:HourglassControl x:Name="Hourglass" Margin="0,28,0,0" HorizontalAlignment="Center" />
            <TextBlock x:Name="CountdownText"
                       Margin="0,16,0,0" FontSize="72" FontWeight="Light"
                       HorizontalAlignment="Center" />
            <Button x:Name="UnlockButton"
                    Style="{StaticResource UnlockButton}"
                    Content="解鎖,繼續工作"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnUnlockClick" />
        </StackPanel>

        <TextBlock x:Name="DisclaimerText"
                   FontSize="13" Foreground="#FF6C7F90"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24" />
    </Grid>
</Window>
