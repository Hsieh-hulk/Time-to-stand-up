<Window x:Class="StandUp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StandUp.App"
        Title="StandUp 設定"
        Width="700" Height="700"
        MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource Glass.TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Glass.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
    <TabControl x:Name="Tabs" Margin="16">
        <TabItem Header="提&#x200A;醒&#x200A;設&#x200A;定" Padding="14,6">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="選擇提醒的節奏" FontSize="18" FontWeight="Medium" Margin="0,0,0,12" />
                    <local:PresetPicker x:Name="Picker" />
                    <CheckBox x:Name="AutoStartBox" Content="開機時自動啟動" Margin="0,18,0,0" />
                    <TextBlock x:Name="ApplyHint" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Glass.SubTextBrush}" />
                </StackPanel>

                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
                    <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="回復預設" Padding="14,5"
                            Click="OnResetClick" />
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="儲存" Padding="22,5" IsDefault="True"
                            Click="OnSaveClick" />
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Padding="22,5"
                            Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick" />
                </DockPanel>
            </Grid>
        </TabItem>

        <TabItem Header="研&#x200A;究&#x200A;依&#x200A;據&#x200A;與&#x200A;關&#x200A;於" Padding="14,6">
            <local:ResearchInfoPanel Margin="18" />
        </TabItem>
    </TabControl>
    <Button x:Name="ThemeButton" Style="{StaticResource Glass.IconButton}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
            AutomationProperties.Name="切換深色與淺色" ToolTip="切換深色 / 淺色"
            Click="OnThemeClick" />
    </Grid>
</Window>
