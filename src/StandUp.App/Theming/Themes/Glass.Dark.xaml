<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色玻璃:灰黑底、極淡的白色卡片與細邊框、橘色強調。 -->
    <SolidColorBrush x:Key="Glass.WindowBrush" Color="#80141518" />
    <SolidColorBrush x:Key="Glass.WindowFallbackBrush" Color="#F01B1C20" />
    <SolidColorBrush x:Key="Glass.TextBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="Glass.SubTextBrush" Color="#A0F2F3F5" />
    <SolidColorBrush x:Key="Glass.CardBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="Glass.CardHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Glass.CardBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Glass.FieldBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Glass.AccentBrush" Color="#FFFF7A2F" />
    <SolidColorBrush x:Key="Glass.OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Glass.ErrorBrush" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Glass.LinkBrush" Color="#FFFF9A3C" />
    <SolidColorBrush x:Key="Glass.LinkHoverBrush" Color="#FFFFC08A" />
    <Color x:Key="Glass.GlowColor">#FFFF6A28</Color>
    <LinearGradientBrush x:Key="Glass.AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF9A3C" Offset="0" />
        <GradientStop Color="#FFFF5A1F" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
