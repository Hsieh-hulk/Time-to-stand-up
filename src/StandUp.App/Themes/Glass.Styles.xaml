<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        玻璃樣式。只併入設定視窗與首次啟動視窗的 Resources,不放在 App.xaml,
        避免影響休息遮罩與提醒氣泡。顏色一律用 DynamicResource 讀 Glass.Dark / Glass.Light。
    -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border HorizontalAlignment="Left" Margin="0,0,0,12" Padding="4" CornerRadius="12"
                                Background="{DynamicResource Glass.CardBrush}"
                                BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <Border Grid.Row="1" CornerRadius="14"
                                Background="{DynamicResource Glass.CardBrush}"
                                BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Glass.SubTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Margin="0,0,4,0" Padding="{TemplateBinding Padding}" CornerRadius="9"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass.CardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass.CardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Glass.CardBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="999"
                            Background="{DynamicResource Glass.CardHoverBrush}"
                            BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsDefault 的按鈕(儲存、開始使用)是畫面上唯一的主要按鈕。 -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass.AccentGradientBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Glass.OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Glass.SubTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Glass.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 圓形圖示按鈕(深/淺色切換)。 -->
    <Style x:Key="Glass.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="20"
                            Background="{DynamicResource Glass.CardBrush}"
                            BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass.CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Glass.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton 是一整張卡片;選取時邊框變強調色並多一圈光暈。 -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Card" Padding="14,12" CornerRadius="12"
                                Background="{DynamicResource Glass.CardBrush}"
                                BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" StrokeThickness="2"
                                             Stroke="{DynamicResource Glass.SubTextBrush}" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Collapsed"
                                             Fill="{DynamicResource Glass.AccentBrush}" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="Glow" CornerRadius="12" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource Glass.AccentBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6"
                                                  Color="{DynamicResource Glass.GlowColor}" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Glass.CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Glass.CardHoverBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Glass.AccentBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Glass.AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Glass.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Glass.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Glass.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Glass.AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Glass.FieldBrush}"
                            BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Glass.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 細捲軸(只做垂直;視窗內沒有水平捲動)。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Margin="1,0"
                                                Background="{DynamicResource Glass.CardBorderBrush}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
