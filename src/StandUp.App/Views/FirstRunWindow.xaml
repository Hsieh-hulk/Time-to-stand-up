<Window x:Class="StandUp.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StandUp.App"
        Title="歡迎使用 StandUp 站起來"
        Width="900" Height="620"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource Glass.TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theming/Themes/Glass.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,52,16">
            <TextBlock Text="歡迎使用 StandUp 站起來" FontSize="24" FontWeight="Medium" />
            <TextBlock Text="連續工作到設定時間後,提醒你站起來走動一下。開始之前,先看看預設值的依據,並選擇提醒的節奏。"
                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Glass.SubTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Padding="16" CornerRadius="14"
                Background="{DynamicResource Glass.CardBrush}"
                BorderBrush="{DynamicResource Glass.CardBorderBrush}" BorderThickness="1">
            <local:ResearchInfoPanel x:Name="Research" ShowAbout="False" />
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Top" Text="提醒設定" FontSize="18" FontWeight="Medium" Margin="0,0,0,10" />
            <local:PresetPicker x:Name="Picker" DockPanel.Dock="Top" />
            <TextBlock DockPanel.Dock="Bottom" x:Name="SettingsHint" Margin="0,10,0,0" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource Glass.SubTextBrush}" />
            <Button DockPanel.Dock="Bottom" x:Name="StartButton" Content="開始使用" IsDefault="True"
                    FontSize="16" FontWeight="Medium" Padding="20,8" HorizontalAlignment="Stretch"
                    Click="OnStartClick" />
        </DockPanel>
    </Grid>
    <Button x:Name="ThemeButton" Style="{StaticResource Glass.IconButton}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"
            AutomationProperties.Name="切換深色與淺色" ToolTip="切換深色 / 淺色"
            Click="OnThemeClick" />
    </Grid>
</Window>
